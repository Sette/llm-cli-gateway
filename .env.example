# --- Globais ---
# Se definida, exige Authorization: Bearer <chave>. (Nome antigo: AGY_API_KEY.)
API_KEY=
# Para onde vai um model sem prefixo (ex.: "gemini-3.7-flash-low").
PROVEDOR_PADRAO=agy
# Quando o pedido não traz model. (Nome antigo: AGY_MODELO_PADRAO.)
MODELO_PADRAO=agy/gemini-3.7-flash-low
HOST=127.0.0.1
PORT=8787

# --- agy (Antigravity) ---
AGY_BIN=agy
AGY_ATIVO=1
AGY_CONCORRENCIA=2
# Segundos entre o início de dois processos do agy (cota por minuto do Google).
AGY_INTERVALO_S=5
# Novas tentativas no erro transitório (modelo recusado: 30, 60, 120 s) e na cota (60 s).
AGY_TENTATIVAS=3
AGY_TIMEOUT_S=180

# --- claude (Claude Code) ---
CLAUDE_BIN=claude
CLAUDE_ATIVO=1
CLAUDE_CONCORRENCIA=2
CLAUDE_TIMEOUT_S=180
CLAUDE_MODELOS=haiku,sonnet,opus

# --- codex ---
CODEX_BIN=codex
CODEX_ATIVO=1
CODEX_CONCORRENCIA=2
CODEX_TIMEOUT_S=180
CODEX_MODELOS=gpt-6-luna,gpt-5.6-terra,gpt-5.6-luna

# --- kiro ---
KIRO_BIN=kiro-cli
KIRO_ATIVO=1
KIRO_CONCORRENCIA=2
KIRO_TIMEOUT_S=180
KIRO_MODELOS=auto,claude-sonnet-4.5,claude-haiku-4.5,deepseek-3.2,glm-5,qwen3-coder-next
