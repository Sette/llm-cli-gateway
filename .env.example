AGY_BIN=agy
# Se definida, exige Authorization: Bearer <chave>.
AGY_API_KEY=
AGY_CONCORRENCIA=2
# Segundos entre o início de dois processos do agy.
AGY_INTERVALO_S=5
# Novas tentativas no erro transitório (modelo recusado: 30, 60, 120 s) e na cota (60 s).
AGY_TENTATIVAS=3
AGY_TIMEOUT_S=180
AGY_MODELO_PADRAO=gemini-3.7-flash-low
HOST=127.0.0.1
PORT=8787
